// Shared.xcconfig — project-wide build settings for Auster.
//
// Every build configuration of every target uses this as its base
// configuration. Target-specific settings live in the target's build
// configuration in Auster.xcodeproj.

// MARK: - Platform & language

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = NO

// MARK: - Versioning

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Hygiene

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_MODULES = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_NO_COMMON_BLOCKS = YES
DEAD_CODE_STRIPPING = YES

// MARK: - Signing
//
// Auster is not sandboxed: a user-chosen sync folder plus full file access
// make the App Sandbox impractical (decisions.md D2). Developer ID signing and
// notarization happen in the release workflow, which passes the identity and
// team on the command line — a local build stays ad-hoc signed.

ENABLE_APP_SANDBOX = NO
CODE_SIGN_STYLE = Automatic

// MARK: - Sparkle updates
//
// The appcast is served from the repository's default branch, which is why the
// release workflow refuses to run from anywhere else: a feed entry stranded on
// a side branch would never reach an installed copy.
//
// "//" opens a comment in an xcconfig, so the URL scheme's separator is broken
// up with an empty $() expansion. The value that reaches Info.plist is the
// ordinary https URL.

SU_FEED_URL = https:/$()/raw.githubusercontent.com/itsjoshpark/auster/main/.sparkle/appcast.xml

// The public half of the EdDSA key pair the release workflow signs each build
// with. Sparkle refuses an update whose signature this key does not verify, so
// a placeholder simply means no updater: `UpdaterManager` reports itself
// unavailable and the update controls disappear.
//
// Replace with the key printed by Sparkle's `generate_keys` (the private half
// becomes the SPARKLE_ED_PRIVATE_KEY repository secret and is never committed).
// See docs/release-process.md.

SU_PUBLIC_ED_KEY = replace_with_the_sparkle_public_key

// MARK: - Dropbox app key
//
// The real key is injected from the gitignored Config/Secrets.xcconfig (see
// Secrets.xcconfig.template). It is empty here so the project builds without
// it — the key is only needed at runtime, from Phase 2 onward. The include
// comes last so Secrets.xcconfig wins when it exists.

DROPBOX_APP_KEY =

#include? "Secrets.xcconfig"
